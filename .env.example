# Copy to .env and adjust. Never commit a real .env.
PORT=8080
HOST=0.0.0.0
# SQLite database file (created automatically)
DB_PATH=./data/fbms.db
# Staff session lifetime
SESSION_TTL_HOURS=12
# Seed demo menu, staff and inventory on first boot of an empty database
SEED_DEMO=true
# Business timezone used for business dates, daily order numbers and Z-readings
TZ_BUSINESS=Asia/Manila
