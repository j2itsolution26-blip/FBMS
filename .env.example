# Copy to .env and adjust. Never commit a real .env.
PORT=8080
HOST=0.0.0.0
# Local SQLite database file (created automatically) — for an in-store server
DB_PATH=./data/fbms.db
# OR a hosted database — required on Vercel (no persistent disk). When set, DB_PATH is ignored.
# PostgreSQL / Neon:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# libSQL / Turso:
# TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=
# Staff session lifetime
SESSION_TTL_HOURS=12
# Seed demo menu, staff and inventory on first boot of an empty database
SEED_DEMO=true
# Also seed ~2 weeks of demo sales (default: on locally, off on Vercel)
# SEED_HISTORY=true
# Business timezone used for business dates, daily order numbers and Z-readings
TZ_BUSINESS=Asia/Manila
